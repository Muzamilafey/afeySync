# Where Next.js proxies /api/* (the AfeySync API). In production nginx routes /api directly.
API_INTERNAL_URL=http://127.0.0.1:4000
# Hostnames that serve the owner portal (comma separated)
OWNER_HOSTS=owner.afeysync.com
# Shown in the facility wizard
NEXT_PUBLIC_PLATFORM_DOMAIN=afeysync.com
# Optional: search engine ownership codes (Google Search Console "HTML tag" and Bing Webmaster "meta tag"), content value only
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
