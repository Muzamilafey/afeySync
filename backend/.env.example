# ---------------------------------------------------------------- Core
NODE_ENV=production
PORT=4000

# Platform metadata database. Tenant databases are created on the same server
# (or on MONGO_TENANT_URI if set) as afeysync_tenant_<slug>.
MONGO_META_URI=mongodb://127.0.0.1:27017/afeysync_meta
# MONGO_TENANT_URI=mongodb://127.0.0.1:27017
TENANT_DB_PREFIX=afeysync_tenant_

# Generate with: openssl rand -hex 48
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=30

# AES-256-GCM key for integration secrets. Generate with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_KEY_ID=k1
# Retired keys kept for decryption during rotation: "k0:<base64>,..."
# INTEGRATION_ENCRYPTION_OLD_KEYS=

FRONTEND_URL=https://app.afeysync.com
OWNER_URL=https://owner.afeysync.com
API_URL=https://api.afeysync.com
PLATFORM_DOMAIN=afeysync.com
OWNER_HOSTS=owner.afeysync.com
CORS_ORIGINS=
# Proxy hops to trust for client IP / X-Forwarded-Host (nginx on the same host = loopback)
TRUST_PROXY=loopback
COOKIE_SECURE=true
RUN_WORKERS=true
LOG_LEVEL=info

REDIS_URL=
FILE_STORAGE_PATH=/var/lib/afeysync/storage

# ---------------------------------------------------------------- Optional first-boot credential import
# If set, these are imported ONCE into the encrypted platform integration store and can then be
# removed from the environment. Afterwards manage credentials in Owner → Integrations.
DHA_BASE_URL=https://ilm-dev.dha.go.ke/uat-middleware/api/v1
DHA_CLIENT_ID=
DHA_CLIENT_SECRET=
DHA_FACILITY_ID=
DHA_FACILITY_ID_TYPE=fr-code

SHA_BASE_URL=https://ilm-dev.dha.go.ke/uat-middleware/api/v1
SHA_CLIENT_ID=
SHA_CLIENT_SECRET=
SHA_FACILITY_ID=

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TILL=
MPESA_PAYBILL=
MPESA_ENVIRONMENT=sandbox

AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=starttls
SMTP_FROM=
