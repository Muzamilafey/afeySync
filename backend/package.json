    "test": "vitest run",
    "seed:owner": "tsx src/scripts/createOwner.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
