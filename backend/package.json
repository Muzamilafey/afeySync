{
  "name": "@afeysync/backend",
  "version": "0.1.0",
  "private": true,
  "description": "AfeySync HMIS API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
